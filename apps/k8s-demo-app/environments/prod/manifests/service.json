{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "k8s-demo-app",
    "namespace": "prod"
  },
  "spec": {
    "ports": [
      {
        "name": "http",
        "port": 80,
        "targetPort": "http"
      }
    ],
    "selector": {
      "app.kubernetes.io/name": "k8s-demo-app"
    },
    "type": "ClusterIP"
  }
}
